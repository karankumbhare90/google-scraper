{
  "name": "mail-agent",
  "version": "1.0.0",
  "description": "Automated Cold Email Lead Generation & Outreach Agent",
  "main": "dashboard.ts",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "backend": "node node_modules/tsx/dist/cli.mjs dashboard.ts",
    "frontend": "cd client && npm run dev",
    "dev": "start cmd /k \"node node_modules/tsx/dist/cli.mjs dashboard.ts\" && cd client && npm run dev"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "googleapis": "^144.0.0",
    "mongoose": "^9.10.3",
    "nodemailer": "^6.9.16",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
