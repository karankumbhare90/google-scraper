# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION (Vite Client)
# ==============================================================================
# Copy this file to client/.env (or client/.env.local)

# Backend API Base URL:
# - Local Development: Leave empty to automatically use Vite's /api proxy to http://127.0.0.1:4200
# - Production (Vercel): Set to your deployed backend URL on Render (e.g. https://google-scraper-backend.onrender.com)
VITE_API_URL=""
