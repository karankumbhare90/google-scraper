# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION (Root / Express & Puppeteer Scraper)
# ==============================================================================
# Copy this file to .env in the root directory and fill in your actual credentials.

# Port (Render/Cloud sets PORT automatically; fallback is DASHBOARD_PORT or 4200)
PORT=4200
DASHBOARD_PORT=4200

# MongoDB Database URL (Required for lead persistence & dashboard stats)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/leadpulse?retryWrites=true&w=majority"

# Dashboard Web Server Port (Default: 4200)
DASHBOARD_PORT=4200

# SMTP Email Dispatch Settings (Gmail / Custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_NAME="Your Name | Your Agency"

# Optional: Set your test email address here during testing so generated emails land in your inbox
TARGET_TEST_EMAIL=""

# Google Gemini AI Key for Lead Synthesis & Email Personalization
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key-here"

# Google Sheets Webhook URL (Instant setup via Google Apps Script)
GOOGLE_SHEET_WEBHOOK_URL=""

# Google Sheets API Configuration (Alternative via Service Account)
GOOGLE_SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Outreach Interval & Safety Limits
EMAIL_INTERVAL_MINUTES=3
DAILY_MAX_EMAILS=50
EXCEL_FILE_PATH="./leads_database.xlsx"

# Meta WhatsApp Cloud API Credentials
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Email Dispatch Toggle (set to "true" to send live emails, "false" to only log data)
ENABLE_EMAIL_DISPATCH="false"
